    {"rule": "Storage = JSONL append-only (dec-007 옵션 A)",                  "why": "v11 안에서 zero-dep 완결. row update 절대 금지 (dec-002 event-sourcing)"},
    {"rule": "모듈별 JSONL 파일 분리 (dec-008) — invoice / contract / ...",     "why": "도메인 분리. scan 비용·백업 단위 분리"},
    {"rule": "PDF/e-sign 외부 의존 금지 v1 (dec-009)",                          "why": "zero-dep + self-hosting. 브라우저 인쇄 + 자체 서명자명 기록만"},
    {"rule": "v11 본체 미접촉 (dec-006)",                                       "why": "본체 회귀 차단. v11 한계는 별도 백로그"},
    {"rule": "외부 npm runtime 의존 0 — package.json dependencies 비움",         "why": "zero-dep 정신 (v11/vcol/elog 계승). JSONL 옵션 A 정합"},
    {"rule": "blog API key·gogs 토큰 등 secret 평문 commit 금지",                "why": "2026-05-21 보안 정책. pre-commit secret scan 정합"},
    {"rule": "클럽 앱 반복 실수 패턴 회피 (res-html/form-parse 금지 등)",         "why": "/root/kim/CLAUDE.md 명시 — 같은 실수 반복 비용"}
  ],

  "graveyard": [
