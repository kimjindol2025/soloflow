{
  "$": "airc-spec",
  "version": "1.0.0",
  "project": "soloflow",
  "date": "2026-05-22",
  "cmd": "python3 -c \"import json; d=json.load(open('SPEC.airc')); print('hot:', d['hot']); print('what:', d['identity']['what']); print('not:', d['identity']['not'])\"",

  "identity": {
    "what": "한국 프리랜서·1인 사업자용 단일 운영 앱 — 대금/계약/일정/집중을 한 곳에서 다룬다",
    "why": "프리랜서가 가장 아픈 3축(대금·계약·일정)을 흩어진 도구 없이 빠르게 처리. SaaS 의존 없이 자체호스팅·zero-dep 으로 통제 가능한 자기 운영 시스템",
    "for": "20대 후반~40대 한국 프리랜서/1인 사업자/부업러/크리에이터. 본인 PC·휴대폰에서 자체호스팅 또는 단일 사용자 인스턴스 운용",
    "not": "팀 협업 도구 아님 (단일 사용자 single-tenant). 회계 정산 SaaS 아님 (세무사 대체 X — 보조 데이터 제공만). 메신저·CRM 통합 허브 아님 (외부 SaaS API 흡수 금지). 모바일 native 앱 아님 v1 (순수 SSR 웹). 다국가 세무/통화 자동 변환 v1 미지원 (KRW 단일)"
  },

  "hot": "v1.1-C",

  "constitution": {
    "1": "AI 전용. 인간 가독성을 위한 구조 타협 금지",
    "2": "identity 잠금 — 변경 사용자 협의 필수. Claude 단독 변경 금지",
    "3": "hot 이 가리키는 task 가 지금 당장 해야 할 일",
    "4": "오류·실수도 nodes 에 기록",
    "5": "노드 삭제 금지 — void 처리만 허용",
    "6": "why 없는 lock·decision 등록 불가"
  },

  "types": {
    "task":     "t + v + entry + check + verified + next",
    "decision": "t + v + why + lock",
    "error":    "t + v + cause + fix + repeat_risk"
  },

  "stack": {
    "language": "FreeLang v11 (.fl) only — 신규 코드 전부",
    "runtime":  "node /root/kim/freelang-v11/bootstrap.js run <file.fl>",
    "storage":  "JSONL (line-delimited JSON) — freelang-elog 의 append-only event log 패턴 차용. v11 file-append/file-read 만 사용. zero-dep",
    "render":   "순수 SSR — server-html / server-redirect / form-field. JS 0 줄 가능",
    "deploy":   "단일 사용자 인스턴스. 공식 서버 (kimjin@123.212.111.26:22253) 또는 로컬",
    "port":     "41955 (41900 = freelang-metric-store 사용 중 → 회피)"
  },

  "domain_map": {
    "M1_invoice": "견적·청구·입금 추적. hot task 첫 모듈",
    "M2_contract": "계약서 템플릿·만료 알림·스코프 체크리스트",
    "M3_schedule": "프로젝트 타임라인·마일스톤·daily focus",
    "M4_focus":   "Pomodoro·집중 시간·습관 체크. 작업 모드 형태로 M1~M3 와 연동",
    "v1.1-A_delivery": "채널별 발송 audit trail (email/sms/kakao/manual). M1/M2와 연동"
  },

  "priority": ["M1_invoice", "M2_contract", "M3_schedule", "M4_focus", "v1.1-A_delivery"],

  "nodes": {

    "task-001": {
      "t": "task",
      "v": "M1 invoice MVP — 송장 등록 / 입금 기록 / 미수금 현황 3축만 (압축)",
      "spec": {
        "domain_events": {
          "invoice.created":          "{id, client, amount_krw, issued_at, due_at, memo}",
          "invoice.payment.received": "{id, paid_amount_krw, paid_at, method}"
        },
        "storage": {
          "underlying": "JSONL — data/invoice-events.jsonl (한 줄 = 한 이벤트)",
          "schema":     "{ts: number, type: string, payload: object}. utf-8 JSON",
          "writer":     "(file-append path (str (json-stringify ev) \"\\n\"))",
          "reader":     "(file-read path) → (str-lines) → (map json-parse) → caller filter (byType / byTimeRange)"
        },
        "state_projection": {
          "invoice":  "events scan → 현재 status 도출 (open / partial / paid). cancelled·sent 는 v1.1 후보",
          "ar_aging": "issued_at + due_at + 현재시각 비교 → overdue 분류 (0-30/31-60/60+)",
          "monthly_revenue": "paid_at 기준 월별 paid_amount_krw 합계"
        },
        "ssr_routes": {
          "GET /":                  "이번 달 수입·미수금 요약 + 오늘 due 인 invoice",
          "GET /invoices":          "전체 invoice 리스트 + status 필터 (open/partial/paid)",
          "GET /invoices/new":      "신규 invoice 폼",
          "POST /invoices":         "invoice.created 이벤트 기록 → /invoices 로 redirect",
          "GET /invoices/:id":      "invoice 상세 + 이벤트 timeline",
          "POST /invoices/:id/pay": "invoice.payment.received 이벤트 기록"
        }
      },
      "scope_in": [
        "domain events 2종 (created, payment.received) — 압축 (사용자 검토 2026-05-22)",
        "invoice ID 생성 (sortable — startTs+seq)",
        "state projection (현재 status open/partial/paid + overdue 분류)",
        "SSR 라우트 6개 (GET /·/invoices·/invoices/new·/invoices/:id, POST /invoices·/:id/pay)",
        "단일 통화 KRW 만",
        "render.fl 헬퍼 (h / redirect-to / form-field)"
      ],
      "scope_out_v1": [
        "invoice.sent 이벤트 (발송 채널 기록) — v1.1 후보. 이메일/SMS 발송 자체는 v2",
        "invoice.cancelled 이벤트 — v1.1 후보 (오기재 정정 흐름)",
        "PDF invoice 생성",
        "이메일/SMS 발송",
        "다중 통화·환율",
        "세무 자동 계산 (예상 소득세·부가세는 v1.x)",
        "클라이언트 master 별도 모듈 (v1 은 invoice payload 안의 client 문자열만)",
        "사용자 인증·다중 사용자",
        "JS 클라이언트 (순수 SSR)"
      ],
      "entry": [
        "src/main.fl",
        "src/invoice.fl",
        "src/state.fl",
        "src/render.fl",
        "data/soloflow-invoice-*.vcol"
      ],
      "check": [
        "node bootstrap.js run src/main.fl → 포트 41955 listen",
        "POST /invoices → invoice.created 이벤트 elog 기록 확인",
        "GET /invoices/:id → timeline 2종 이벤트 round-trip 가능 (created/payment)",
        "overdue 분류 정확도 (due_at < now & status != paid) 단위 검증",
        "monthly revenue 합계 = 같은 달 payment.received 이벤트 amount 합계",
        "부분입금 (paid_amount < amount) 시 status = partial 도출"
      ],
      "verified": true,
      "verified_at": "2026-05-22",
      "verified_evidence": "E2E 6/6 PASS — home/create/partial-pay/full-pay/overdue/list-filter 모두 검증. JSONL 4 events round-trip 확인",
      "next": ["task-002"]
    },

    "task-002": {
      "t": "task",
      "v": "M1 미수금 자동 분류 + 요약 대시보드 (root /) — fixture 기반 단위 검증",
      "spec": {
        "aging_buckets": ["예정", "0-30일", "31-60일", "60일 초과"],
        "summary_cards": ["이번 달 수입(paid 합계)", "총 미수금(unpaid balance 합)", "미수 송장 수", "오늘 due", "이번 주 due (7일 이내)"],
        "fixture_kinds": "4종 (paid·partial·overdue·open) — task-001 압축으로 sent/draft/cancelled 부재. v1.1 후보",
        "env_override": "SOLOFLOW_EVENTS_PATH 환경변수로 EVENTS-PATH override. 테스트 격리용"
      },
      "scope_in": [
        "GET / 요약 페이지 SSR — 5 cards",
        "aging projection 함수 (예정/0-30/31-60/60일 초과)",
        "due-this-week 함수 신설",
        "tests/projection-test.fl — assert 기반 단위 검증"
      ],
      "entry": ["src/render.fl", "src/state.fl", "src/invoice.fl", "tests/projection-test.fl"],
      "check": [
        "fixture invoice 4종 (paid/partial/overdue/open) → 요약 카드 5종 정확",
        "aging bucket 경계값 (0/30/31/60/61일) 정확",
        "compute-status 5종 (paid/초과수금/partial/overdue/open) 정확",
        "tests/projection-test.fl 26/26 PASS"
      ],
      "verified": true,
      "verified_at": "2026-05-23",
      "verified_evidence": "tests/projection-test.fl 26/26 PASS. live 서버 GET / 5 cards 렌더링 확인",
      "next": []
    },

    "task-003": {
      "t": "task",
      "v": "S0 리포 초기화 — git init + .gitignore + package.json (zero-dep) + README 최소. Gogs push 는 토큰 갱신 후 별도",
      "spec": {
        "gogs": "gogs.dclub.kr/kim/soloflow — 토큰 403 (2026-05-22) 으로 push 보류. 갱신 후 git push -u",
        "deps_pattern": "zero-dep — package.json dependencies 비움 (dec-007 옵션 A 정합)",
        "freelang_path": "bootstrap.js 경로 /root/kim/freelang-v11/bootstrap.js (baseline master)"
      },
      "scope_in": [
        "git init + 초기 커밋 (SPEC.airc / .gitignore / package.json / README.md)",
        ".gitignore (data/*.jsonl, node_modules, .env)",
        "package.json + scripts (start / spec)",
        "README.md 최소 (1 단락)"
      ],
      "entry": [".gitignore", "package.json", "README.md"],
      "check": [
        "git log --oneline 첫 커밋 존재",
        "python3 -c '...' SPEC.airc JSON parse OK",
        "Gogs push 는 토큰 갱신 후 task-004 로 분리"
      ],
      "verified": true,
      "verified_at": "2026-05-22",
      "verified_note": "로컬 init/commit 완료. Gogs push 는 토큰 403 으로 task-004 분리",
      "next": ["task-001", "task-004"]
    },

    "task-004": {
      "t": "task",
      "v": "Gogs push — 토큰 갱신 후 origin 등록 + initial push",
      "spec": {
        "blocker": "GOGS_TOKEN 403 (2026-05-22). gogs.dclub.kr Settings → Applications → 새 토큰 발급 → /root/kim/.env 의 GOGS_TOKEN 교체 필요",
        "steps": [
          "1. /root/kim/.env GOGS_TOKEN 갱신",
          "2. POST https://gogs.dclub.kr/api/v1/user/repos {name:soloflow}",
          "3. git remote add origin https://gogs.dclub.kr/kim/soloflow.git",
          "4. git push -u origin master"
        ]
      },
      "scope_in": ["토큰 갱신 (사용자 액션)", "Gogs 리포 생성", "remote add + push"],
      "entry": ["/root/kim/.env"],
      "check": ["git ls-remote origin master 결과 sha 존재"],
      "verified": true,
      "verified_at": "2026-05-23",
      "verified_evidence": "토큰 재인증 OK (LIST repos 560건 확인) → API repo 생성 → git push -u origin master 성공. remote URL 토큰 제거 (.git/config 평문 secret 금지)",
      "next": []
    },

    "dec-001": {
      "t": "decision",
      "v": "별도 리포 (gogs.dclub.kr/kim/soloflow) — vcol/elog/v11 본체와 분리",
      "why": [
        "soloflow 는 application layer. vcol(storage) / elog(event log) / v11(language) 본체 회귀 차단",
        "3 axis independence 정신 (vcol dec-001 / elog dec-007 계승)",
        "square-freelang 과 다른 도메인 — 결제/POS 아닌 프리랜서 운영. 흡수 시 도메인 혼합"
      ],
      "lock": true
    },

    "dec-002": {
      "t": "decision",
      "v": "Event sourcing 패턴 — invoice/payment 는 elog 위 도메인 이벤트로 기록. 상태는 projection",
      "why": [
        "elog 가 columnar append-only — in-place update 불가. status 변경(draft→sent→paid)은 이벤트로만 표현",
        "audit trail 자동 확보 — 모든 상태 전환 history 보존",
        "v0.1 schema (ts/type/payload) 위에 자연스럽게 매핑. 별도 storage 도입 시 elog 자산 낭비"
      ],
      "rules": [
        "쓰기는 항상 이벤트 append 만. 직접 row update 금지",
        "상태는 reader scan 결과 projection. cache 는 v1 후보 (overhead 측정 후)",
        "이벤트 type 명명: '<aggregate>.<verb>' (snake.dotted)"
      ],
      "lock": true
    },

    "dec-003": {
      "t": "decision",
      "v": "단일 통화 KRW (₩) v1 — 다국가/환율 v2 후보",
      "why": [
        "타겟 = 한국 프리랜서. 90%+ 케이스 KRW",
        "다국가 시 환율 source·역사 환율 보존·세금 모델 폭발 → MVP 범위 초과"
      ],
      "rules": [
        "payload amount_krw 정수 (원 단위, 소수점 금지)",
        "다국가는 v2 — '신규 통화 enum + 환율 스냅샷 이벤트' 추가 cycle 별도"
      ],
      "lock": false
    },

    "dec-004": {
      "t": "decision",
      "v": "단일 사용자 single-tenant v1 — 인증·다중 사용자 v2 후보",
      "why": [
        "자체호스팅 모델 = 1 인스턴스 = 1 사용자 가정",
        "인증 도입 시 cookie/session/CSRF 복잡도 폭발 → v2 cycle",
        "공개 인터넷 노출 시 reverse proxy (nginx basic auth) 우회 권장 — 앱 책임 아님"
      ],
      "rules": [
        "v1 라우트 인증 체크 없음. localhost 또는 사설망 운용 가정",
        "v2 = login/logout + cookie 인증 + 사용자별 elog 파일 분리"
      ],
      "lock": false
    },

    "dec-005": {
      "t": "decision",
      "v": "순수 SSR — JS 0 줄. form POST + server-html 렌더링만",
      "why": [
        "memory feedback_freelang_ssr_no_js — JS 없이 완전한 앱 가능. 단순성·번들리스",
        "FreeLang v11 의 server-html / server-redirect / form-field 로 충분",
        "JS 도입 시 빌드 파이프라인·번들·hydration 복잡도. MVP 범위 초과"
      ],
      "rules": [
        "<script> 태그 금지 v1",
        "동적 인터랙션 필요 시 form POST + redirect 패턴",
        "클럽 앱 반복 실수 회피 — (server-html ...) / (server-redirect ...) / (form-field raw \"key\") 만 사용"
      ],
      "lock": true
    },

    "dec-006": {
      "t": "decision",
      "v": "FreeLang v11 baseline = master (legacy core). fx 1192 (truth set) 직접 사용 금지 v1",
      "why": [
        "memory project_freelang_v11_baseline — fx 가 truth set 이나 baseline freeze 직후",
        "신규 application 이 v11 회귀 강제하지 않도록 master 기준. 안정성 우선",
        "v11 본체 변경 필요 시 별도 cycle. soloflow 안에서 v11 패치 금지"
      ],
      "rules": [
        "bootstrap.js 경로 = /root/kim/freelang-v11/bootstrap.js (master)",
        "v11 본체 미접촉. v11 stdlib 86개 안에서 해결",
        "v11 한계 발견 시 graveyard + FreeLang 백로그로 분리"
      ],
      "lock": false
    },

    "M1-done": {
      "t": "task",
      "v": "M1 invoice MVP 완료 — M2 contract 으로 이동 (2026-05-23)",
      "spec": {
        "completed": ["task-003 (S0 init)", "task-001 (M1 MVP)", "task-004 (Gogs push)", "task-002 (projection 검증)"],
        "decided_next": "M2 계약 — A 압축형 + 이벤트 2종 + 자체 minimal 용역계약 (사용자 결정 2026-05-23)"
      },
      "scope_in": ["다음 모듈 선정"],
      "entry": ["SPEC.airc"],
      "check": ["task-005 신설"],
      "verified": true,
      "verified_at": "2026-05-23",
      "verified_evidence": "사용자 결정 = A + 2종 + 자체 minimal",
      "next": ["task-005"]
    },

    "task-005": {
      "t": "task",
      "v": "M2 contract MVP — 자체 minimal 용역계약 + created/signed 이벤트 2종 + SSR 6 라우트",
      "spec": {
        "domain_events": {
          "contract.created": "{id, title, party_a, party_b, scope, period_start, period_end, amount_krw, vat_included, payment_terms, memo}",
          "contract.signed":  "{id, signer_name, signer_role, signed_at, note}"
        },
        "storage": {
          "underlying": "JSONL — data/contract-events.jsonl (invoice 와 별도 파일 — dec-008)",
          "schema":     "{ts: number, type: string, payload: object}. utf-8 JSON",
          "writer":     "(file-append path (str (json-stringify ev) \"\\n\"))",
          "reader":     "(file-read path) → (str-lines) → (map json-parse) → caller filter"
        },
        "state_projection": {
          "contract_status": "events scan → draft (signed 이벤트 없음) / active (signed + period_end >= now) / expired (signed + period_end < now)",
          "expiring_soon":   "active + period_end - now <= 14일 → 임박 표시 (GET 시점 계산, cron 없음)"
        },
        "ssr_routes": {
          "GET /contracts":              "전체 리스트 + status 필터 (draft/active/expired)",
          "GET /contracts/new":          "용역계약 minimal 템플릿 폼",
          "POST /contracts":             "contract.created 이벤트 기록 → /contracts/:id redirect",
          "GET /contracts/:id":          "상세 + 이벤트 timeline + 인쇄용 계약문 (브라우저 인쇄 → PDF 우회)",
          "POST /contracts/:id/sign":    "contract.signed 이벤트 기록",
          "GET /contracts/:id/print":    "단독 인쇄 페이지 (네비 제거, 깔끔 레이아웃)"
        },
        "template_minimal": {
          "title":          "용역계약서",
          "sections":       ["당사자(갑/을)", "용역 범위", "계약 기간", "용역 대금", "지급 조건", "비밀유지", "기타"],
          "variable_form":  "{{변수명}} (str-replace-all 치환)",
          "boilerplate":    "고정 문구 + 변수만 사용자 입력. v1 = 1종 minimal. 다중 템플릿/표준계약서 흡수는 v2 후보"
        }
      },
      "scope_in": [
        "domain events 2종 (contract.created · contract.signed)",
        "contract ID 생성 (sortable — startTs+seq, invoice 패턴 답습)",
        "state projection (status / expiring_soon)",
