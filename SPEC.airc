    "task-006": {
      "t": "task",
      "v": "M1.1 invoice lifecycle 보강 — sent/cancelled 이벤트 + state machine invariant + append-only audit",
      "spec": {
        "state_machine": {
          "draft":     "created 만. sent/payment/cancelled 없음",
          "sent":      "created + sent (단 1회 인정). payment 없음. not cancelled",
          "partial":   "sent + 0 < paid < amount. not cancelled",
          "paid":      "sent + paid >= amount. not cancelled",
          "overdue":   "sent + due_at < now + paid < amount + not cancelled",
          "cancelled": "cancelled 이벤트 (단 1회). 이전 status 가 draft/sent 일 때만 진입 허용"
        },
        "domain_events_added": {
          "invoice.sent":      "{id, sent_at, channel?}  — channel v1.x 후보",
          "invoice.cancelled": "{id, cancelled_at, reason}"
        },
        "transitions": {
          "draft → sent":      "POST /invoices/:id/send",
          "draft → cancelled": "POST /invoices/:id/cancel",
          "sent → partial":    "POST /invoices/:id/pay (partial)",
          "sent → paid":       "POST /invoices/:id/pay (full)",
          "sent → cancelled":  "POST /invoices/:id/cancel",
          "partial → paid":    "POST /invoices/:id/pay 추가",
          "sent → overdue":    "암묵 (시간 경과)"
        },
        "invariants": [
          "I1: paid 이후 cancel 거부 (409)",
          "I2: cancelled 이후 sent/payment 추가 거부 (409)",
          "I3: sent 안 된 invoice 에 payment 거부 (409)",
          "I4: duplicate sent 이벤트 → idempotent (첫 번째만 인정, 두 번째 거부 409)",
          "I5: duplicate cancel 이벤트 → idempotent (동일)",
          "I6: 직접 row update 절대 금지 (dec-002). status 는 events scan projection 결과만"
        ],
        "ssr_routes_changed": {
          "POST /invoices/:id/send":   "NEW — invoice.sent 이벤트. status=draft 검증",
          "POST /invoices/:id/cancel": "NEW — invoice.cancelled 이벤트. status ∈ {draft,sent} 검증 + reason 필드",
          "POST /invoices/:id/pay":    "MOD — status ∈ {sent,partial} 검증. draft/paid/cancelled 거부",
          "GET /invoices/:id":         "MOD — status 별 버튼 분기. 취소 사유 표시"
        },
        "ui_buttons_by_status": {
          "draft":     "[송장 발행] [취소]",
          "sent":      "[입금 기록] [취소]",
          "partial":   "[입금 기록]",
          "paid":      "(완납)",
          "overdue":   "[입금 기록] (연체)",
          "cancelled": "(취소됨 — 사유 표시)"
        },
        "list_filter": "status: draft / sent / partial / paid / overdue / cancelled (6종)"
      },
      "scope_in": [
        "src/state.fl: compute-status 6종 state machine 로 재작성",
        "src/state.fl: events-of-id-have? 헬퍼 (sent/cancelled 존재 검사)",
        "src/state.fl: project-invoice 에 sent_at / cancelled_at / cancel_reason / lifecycle 추가",
        "src/invoice.fl: 2개 신규 라우트 (send, cancel) + 폼·핸들러",
        "src/invoice.fl: 상세 페이지 status 별 버튼 분기",
        "src/invoice.fl: 리스트 필터 6종 정합",
        "tests/lifecycle-test.fl: state machine + invariant I1~I6 검증 (12+ assert)"
      ],
      "scope_out_v1_1": [
        "invoice.sent.channel (이메일/메신저 발송 채널) — v1.x 후보",
        "amended 이벤트 (정정) — v1.2 후보",
        "마이그레이션 스크립트 — 기존 운영 데이터 없으므로 불필요"
      ],
      "entry": [
        "src/state.fl",
        "src/invoice.fl",
        "tests/lifecycle-test.fl"
      ],
      "check": [
        "lifecycle-test.fl PASS (state machine 전이 6종 + invariant 6종)",
        "live E2E: draft→sent→paid 흐름 OK",
        "live E2E: draft→cancelled 흐름 OK",
        "live E2E: I1~I3 거부 동작 (paid 후 cancel / cancelled 후 pay / draft 에서 pay) → 409",
        "리스트 필터 6종 정상"
      ],
      "verified": true,
      "verified_at": "2026-05-23",
      "verified_evidence": "lifecycle-test.fl 31/31 PASS (6-state 전이 + invariant I1-I5). status-badge 6종 (draft/sent/partial/paid/overdue/cancelled). render-action-buttons 상태별 버튼 분기. handle-send/cancel/pay invariant 검사 (409 에러).",
      "next": ["task-007"]
    },

    "task-007": {
      "t": "task",
      "v": "M2.1 contract cron — 일일 expiring reminder + time-based projection consistency",
      "spec": {
        "domain_events_added": {
          "contract.expiring": "{id, expiring_at, days_until_expire, threshold_days (14/7/1), triggered_by_cron}"
        },
        "cron_behavior": {
          "schedule":  "매일 정해진 시각 (예: 자정 UTC). single-tenant 단일 인스턴스만 실행 (multi-process 동시 실행 금지)",
          "scan": "모든 active contract → period_end 계산 → 14d/7d/1d threshold 검사",
          "duplicate_collapse": "같은 contract + 같은 threshold → 최근 contract.expiring 이벤트 1개만 (idempotent). 다시 cron 재실행해도 중복 X",
          "skip_cancelled": "cancelled contract는 reminder 생성 안 함 (이미 끝난 것). status projection 확인 후 skip"
        },
        "invariants": [
          "I1: expired projection-only. reminder 없음. cron 대상 아님",
          "I2: same threshold duplicate 금지 (같은 contract + 같은 14d → 1회만). 2회 목 cron 재실행해도 409 X, idempotent",
          "I3: cancelled contract reminder 금지. cancelled_at 있으면 remind 안 함",
          "I4: reminder != state mutation. contract.expiring 이벤트는 status 변경 X. projection-only audit trail"
        ],
        "projection": {
          "contract_reminders": "contract id → recent contract.expiring 이벤트들 (threshold 별 스냅샷)",
          "expiring_contracts_14d": "14d threshold reminder 있는 contract 필터 (시각적 경고)",
          "expiring_contracts_7d": "7d threshold reminder",
          "expiring_contracts_1d": "1d threshold reminder"
        },
        "ssr_routes_changed": {
          "GET /contracts": "expiring reminder badge 표시 (14d: yellow, 7d: orange, 1d: red)",
          "GET /contracts/:id": "recent contract.expiring 이벤트들 timeline 표시"
        }
      },
      "scope_in": [
        "src/contract-state.fl: contract-expiring? 헬퍼 (period_end - now <= 14d 검사)",
        "src/contract-state.fl: contract-expired? 헬퍼 (period_end < now, cron 제외)",
        "src/contract-state.fl: append-contract-expiring-event 함수 (contract.expiring 기록)",
        "src/cron.fl: 신규 파일. daily cron driver (매일 1회)",
        "src/cron.fl: scan-expiring-contracts 함수 (전체 contract 스캔 + threshold 검사)",
        "src/cron.fl: idempotent check (same contract + same threshold → 최근 이벤트 1개만)",
        "src/contract.fl: 14d/7d/1d reminder badge 렌더링 (상세/리스트)",
        "src/render.fl: expiring badge style (draft/active/expired 와 별개, reminder 스타일)",
        "tests/cron-test.fl: cron scan + duplicate collapse + boundary (14d/7d/1d) + cancelled skip 검증"
      ],
      "scope_out_v1_1": [
        "Discord/이메일 알림 발송 (reminder 이벤트만 기록, 발송은 외부 도구)",
        "타임존 설정 (UTC 고정 v1)",
        "cron 스케줄 설정 UI (v2 후보)"
      ],
      "entry": [
        "src/cron.fl",
        "src/contract-state.fl",
        "src/contract.fl",
        "src/render.fl",
        "tests/cron-test.fl"
      ],
      "check": [
        "cron-test.fl PASS (scan 정확 + duplicate collapse + boundary ± 14d/7d/1d + cancelled skip)",
        "live: 14d reminder 생성 → badge 표시",
        "live: cron 재실행 → 중복 X (idempotent)",
        "live: contract cancelled → reminder 안 생김",
        "live: expired contract → reminder 안 생김 (projection-only)"
      ],
      "verified": true,
      "verified_at": "2026-05-23",
      "verified_evidence": "cron-test.fl 23/23 PASS (days calc + threshold + duplicate collapse + cancelled skip). scan-expiring-contracts idempotent (2회 재실행 시 reminder 변화 없음). render-expiring-badges 3색 (1d/7d/14d). contract.cancelled 상태 제외됨.",
      "next": ["task-008"]
    },

