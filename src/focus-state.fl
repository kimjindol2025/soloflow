; soloflow focus-state.fl — M4 focus (Pomodoro + Habit) event sourcing + projection
; event-sourcing: append-only JSONL (focus-events.jsonl)
; projection-only: active session, today stats, habit streak 모두 derived

; ── FOCUS-EVENTS-PATH override (테스트 격리) ──────────────────
(define FOCUS-EVENTS-PATH
  (let [override (env-get "SOLOFLOW_FOCUS_EVENTS_PATH")]
    (if (or (nil? override) (str-blank? override)) "data/focus-events.jsonl" override)))

; ── 이벤트 append ──────────────────────────────────────────────
(defn append-focus-event [type payload]
  (let [ev {"ts" (now-ms) "type" type "payload" payload}
        line (str (json-stringify ev) "\n")]
    (file-append FOCUS-EVENTS-PATH line)
    ev))

; ── 전체 이벤트 읽기 ───────────────────────────────────────────
(defn read-focus-events []
  (if (not (file-exists FOCUS-EVENTS-PATH))
    []
    (let [raw (file-read FOCUS-EVENTS-PATH)
          lines (str-lines raw)
          non-empty (filter (fn [l] (not (str-blank? l))) lines)]
      (map (fn [l] (json-parse l)) non-empty))))

(defn focus-events-of-type [type]
  (filter (fn [e] (= (get e "type") type)) (read-focus-events)))

(defn focus-events-for-session [session-id]
  (filter
    (fn [e] (= (get (get e "payload") "session_id") session-id))
    (read-focus-events)))

; ── Active Session 식별 ────────────────────────────────────────
; active = focus.started 있고, 같은 session_id로 completed/cancelled 없음
(defn active-session []
  (let [all-evs (read-focus-events)
        started-list (filter (fn [e] (= (get e "type") "focus.started")) all-evs)
        sorted-started (reverse started-list)  ; 최근 순
        completed-list (filter (fn [e] (= (get e "type") "focus.completed")) all-evs)
        cancelled-list (filter (fn [e] (= (get e "type") "focus.cancelled")) all-evs)]
    (let [result (first
                   (filter
                     (fn [s-ev]
                       (let [sid (get (get s-ev "payload") "id")
                             has-complete (> (length (filter (fn [c] (= (get (get c "payload") "session_id") sid)) completed-list)) 0)
                             has-cancel (> (length (filter (fn [c] (= (get (get c "payload") "session_id") sid)) cancelled-list)) 0)]
                         (and (not has-complete) (not has-cancel))))
                     sorted-started))]
      result)))

; ── Session 일시정지 상태 확인 ──────────────────────────────────
; paused? = 마지막 pause/resume 이벤트가 focus.paused
(defn session-paused? [session-id]
  (let [evs (focus-events-for-session session-id)
        pause-resume (filter
                       (fn [e]
                         (let [t (get e "type")]
                           (or (= t "focus.paused") (= t "focus.resumed"))))
                       evs)]
    (if (= (length pause-resume) 0)
      false
      (= (get (last pause-resume) "type") "focus.paused"))))

; ── 오늘 완료된 Session 목록 ────────────────────────────────────
(defn today-sessions []
  (let [all-evs (read-focus-events)
        today-start (date-parse (date-format (now-ms) "yyyy-MM-dd"))
        completed (filter
                    (fn [e]
                      (and (= (get e "type") "focus.completed")
                           (>= (get e "ts") today-start)))
                    all-evs)]
    (map
      (fn [c-ev]
        (let [payload (get c-ev "payload")
              sid (get payload "session_id")
              started (first (filter (fn [s] (= (get (get s "payload") "id") sid)) (filter (fn [e] (= (get e "type") "focus.started")) all-evs)))]
          (if (nil? started)
            nil
            {"session_id" sid
             "started_at" (get (get started "payload") "started_at")
             "planned_mins" (get (get started "payload") "planned_mins")
             "completed_at" (get payload "completed_at")
             "actual_mins" (get payload "actual_mins")
             "notes" (get payload "notes")})))
      completed)))

; ── 오늘 총 집중 시간 (분) ─────────────────────────────────────
(defn today-focus-mins []
  (let [sessions (today-sessions)
        mins (map (fn [s] (get s "actual_mins")) sessions)]
    (reduce + 0 mins)))

; ── 모든 Habit 조회 (archived 제외) ────────────────────────────
(defn all-habits []
  (let [all-evs (read-focus-events)
        created (filter (fn [e] (= (get e "type") "habit.created")) all-evs)
        archived (filter (fn [e] (= (get e "type") "habit.archived")) all-evs)
        archived-ids (map (fn [e] (get (get e "payload") "habit_id")) archived)]
    (filter
      (fn [h]
        (not (> (length (filter (fn [aid] (= aid (get (get h "payload") "id"))) archived-ids)) 0)))
      created)))

; ── Habit 상세 정보 ────────────────────────────────────────────
(defn habit-detail [habit-id]
  (let [all-evs (read-focus-events)
        created-list (filter
                       (fn [e]
                         (and (= (get e "type") "habit.created")
                              (= (get (get e "payload") "id") habit-id)))
                       all-evs)]
    (if (= (length created-list) 0)
      nil
      (let [payload (get (get created-list 0) "payload")
            archived-list (filter
                            (fn [e]
                              (and (= (get e "type") "habit.archived")
                                   (= (get (get e "payload") "habit_id") habit-id)))
                            all-evs)]
        {"id" habit-id
         "title" (get payload "title")
         "description" (get payload "description")
         "created_at" (get (get created-list 0) "ts")
         "archived" (> (length archived-list) 0)
         "archived_at" (if (> (length archived-list) 0) (get (get archived-list 0) "payload") nil)
         "checks" (effective-checks habit-id)}))))

; ── 오늘 Habit 체크 여부 (net: 마지막 이벤트가 checked) ──────────
(defn habit-checked-today? [habit-id]
  (let [today-str (date-format (now-ms) "yyyy-MM-dd")
        all-evs (read-focus-events)
        today-events (filter
                       (fn [e]
                         (and (or (= (get e "type") "habit.checked")
                                  (= (get e "type") "habit.unchecked"))
                              (= (get (get e "payload") "habit_id") habit-id)
                              (= (get (get e "payload") "date") today-str)))
                       all-evs)]
    (if (= (length today-events) 0)
      false
      (= (get (last today-events) "type") "habit.checked"))))

; ── Habit 연속 체크 일 수 (Streak) ─────────────────────────────
; 오늘부터 거슬러 연속 체크된 날 개수 (오늘 미체크면 어제부터)
(defn habit-streak [habit-id]
  (let [checks (effective-checks habit-id)
        today-str (date-format (now-ms) "yyyy-MM-dd")
        today-ms (date-parse today-str)
        day-ms 86400000
        check-set (reduce (fn [acc d] (assoc acc d true)) {} checks)]
    (loop [count 0 current-offset 0]
      (let [check-date (date-format (- today-ms (* day-ms current-offset)) "yyyy-MM-dd")]
        (if (nil? (get check-set check-date))
          count
          (recur (+ count 1) (+ current-offset 1)))))))

; ── Habit 실제 체크 날짜 목록 (check 미만 uncheck 필터링) ───────
; 각 날짜별로 마지막 check/uncheck 이벤트가 checked 인 날짜들
(defn effective-checks [habit-id]
  (let [all-evs (read-focus-events)
        check-evs (filter
                    (fn [e]
                      (and (= (get e "type") "habit.checked")
                           (= (get (get e "payload") "habit_id") habit-id)))
                    all-evs)
        uncheck-evs (filter
                      (fn [e]
                        (and (= (get e "type") "habit.unchecked")
                             (= (get (get e "payload") "habit_id") habit-id)))
                      all-evs)
        all-dates (reduce
                    (fn [acc ev]
                      (let [date (get (get ev "payload") "date")]
                        (assoc acc date true)))
                    {}
                    (concat check-evs uncheck-evs))]
    (map
      (fn [d]
        d)
      (filter
        (fn [date]
          (let [date-checks (filter (fn [e] (= (get (get e "payload") "date") date)) check-evs)
                date-unchecks (filter (fn [e] (= (get (get e "payload") "date") date)) uncheck-evs)
                all-date-evs (concat date-checks date-unchecks)
                last-ev (last (sort-by (fn [e] (get e "ts")) all-date-evs))]
            (= (get last-ev "type") "habit.checked")))
        (keys all-dates)))))

; ── ID 생성 ────────────────────────────────────────────────────
(defn make-session-id []
  (str "pomo-" (now-ms) "-" (str-slice (uuid) 0 6)))

(defn make-habit-id []
  (str "habit-" (now-ms) "-" (str-slice (uuid) 0 6)))
