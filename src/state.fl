; soloflow state.fl — event log + projection
; dec-002 LOCK: event sourcing. 직접 row update 금지. append 만.
; dec-007 LOCK: JSONL. data/invoice-events.jsonl 한 파일.
; v1.2-P1: one-pass scan. read-events 1회 → list-invoices-from-events

; EVENTS-PATH 는 SOLOFLOW_EVENTS_PATH 환경변수로 override 가능 (테스트 격리용)
(define EVENTS-PATH
  (let [override (env-get "SOLOFLOW_EVENTS_PATH")]
    (if (or (nil? override) (str-blank? override)) "data/invoice-events.jsonl" override)))

; ── 계측: read-events 호출 횟수 ──────────────────────────────
(define READ-EVENTS-COUNT (atom 0))

; ── 이벤트 append (atomic file-append) ─────────────────────
(defn append-event [type payload]
  (let [ev {"ts" (now-ms) "type" type "payload" payload}
        line (str (json-stringify ev) "\n")]
    (file-append EVENTS-PATH line)
    ev))

; ── 전체 이벤트 읽기 (계측 포함) ────────────────────────────
(defn read-events []
  (do (swap! READ-EVENTS-COUNT + 1)
      (if (not (file-exists EVENTS-PATH))
        []
        (let [raw (file-read EVENTS-PATH)
              lines (str-lines raw)
              non-empty (filter (fn [l] (not (str-blank? l))) lines)]
          (map (fn [l] (json-parse l)) non-empty)))))

; ── 타입별 필터 ─────────────────────────────────────────────
(defn events-of-type [type]
  (filter (fn [e] (= (get e "type") type)) (read-events)))

; ── 특정 invoice id 의 이벤트 ──────────────────────────────
(defn events-for-id [id]
  (filter
    (fn [e] (= (get (get e "payload") "id") id))
    (read-events)))

; ── 특정 ID에 특정 type 이벤트 있는지 검사 (sent/cancelled 존재) ─
(defn events-of-id-have? [id type]
  (let [evs (events-for-id id)
        match (filter (fn [e] (= (get e "type") type)) evs)]
    (> (length match) 0)))

; ── status 산출: 6-state machine (draft/sent/partial/paid/overdue/cancelled) ──
(defn compute-status [amount paid due-at has-sent has-cancel]
  (cond
    has-cancel                   "cancelled"
    (not has-sent)               "draft"
    (>= paid amount)             "paid"
    (> paid 0)                   "partial"
    (and (not (nil? due-at))
         (< due-at (now-ms)))    "overdue"
    :else                        "sent"))

; ── 단일 송장 projection (내부 로직만, evs는 외부에서 필터된 것) ──
(defn project-invoice-from-events [id evs]
  (let [created-list (filter (fn [e] (= (get e "type") "invoice.created")) evs)
        send-list    (filter (fn [e] (= (get e "type") "invoice.sent")) evs)
        cancel-list  (filter (fn [e] (= (get e "type") "invoice.cancelled")) evs)
        pay-list     (filter (fn [e] (= (get e "type") "invoice.payment.received")) evs)]
    (if (= (length created-list) 0)
      nil
      (let [c (get (get created-list 0) "payload")
            paid-sum (sum (map (fn [p] (get (get p "payload") "paid_amount_krw")) pay-list))
            amt (get c "amount_krw")
            has-sent (> (length send-list) 0)
            has-cancel (> (length cancel-list) 0)
            status (compute-status amt paid-sum (get c "due_at") has-sent has-cancel)
            sent-info (if (> (length send-list) 0) (get (get send-list 0) "payload") nil)
            cancel-info (if (> (length cancel-list) 0) (get (get cancel-list 0) "payload") nil)
            payments (map (fn [p]
                            (let [pp (get p "payload")]
                              {"ts" (get p "ts")
                               "amount" (get pp "paid_amount_krw")
                               "paid_at" (get pp "paid_at")
                               "method" (get pp "method")}))
                          pay-list)]
        {"id" id
         "client" (get c "client")
         "amount_krw" amt
         "issued_at" (get c "issued_at")
         "due_at" (get c "due_at")
         "memo" (get c "memo")
         "paid_sum" paid-sum
         "balance" (- amt paid-sum)
         "status" status
         "sent_at" (if (nil? sent-info) nil (get sent-info "sent_at"))
         "cancelled_at" (if (nil? cancel-info) nil (get cancel-info "cancelled_at"))
         "cancel_reason" (if (nil? cancel-info) nil (get cancel-info "reason"))
         "payments" payments}))))

; ── backward-compat wrapper: project-invoice(id) ───────────────
(defn project-invoice [id]
  (let [evs (events-for-id id)]
    (project-invoice-from-events id evs)))

; ── 전체 송장 리스트 (이미 읽은 evs에서 projection) ───────────
(defn list-invoices-from-events [evs]
  (let [created (filter (fn [e] (= (get e "type") "invoice.created")) evs)
        ids (map (fn [e] (get (get e "payload") "id")) created)]
    (compact (map (fn [id]
                    (let [id-evs (filter
                                   (fn [e] (= (get (get e "payload") "id") id))
                                   evs)]
                      (project-invoice-from-events id id-evs)))
                  ids))))

; ── backward-compat wrapper: list-invoices() ───────────────────
(defn list-invoices []
  (let [evs (read-events)]
    (list-invoices-from-events evs)))

; ── 미수금 필터 (이미 생성된 invoices에서) ───────────────────
(defn unpaid-invoices-from-invoices [invs]
  (filter (fn [inv] (not (= (get inv "status") "paid"))) invs))

; ── backward-compat wrapper: unpaid-invoices() ─────────────────
(defn unpaid-invoices []
  (unpaid-invoices-from-invoices (list-invoices)))

; ── aging bucket: now - due_at → "0-30" / "31-60" / "60+" ──
(defn aging-bucket [inv]
  (let [due (get inv "due_at")]
    (if (nil? due)
      "—"
      (let [days (date-diff due (now-ms) "days")]
        (cond
          (<= days 0)   "예정"
          (<= days 30)  "0-30일"
          (<= days 60)  "31-60일"
          :else         "60일 초과")))))

; ── 이번 달 수입: paid_at 기준 같은 YYYY-MM 인 payment 합계 ──
(defn monthly-revenue-from-events [year-month evs]
  (let [pays (filter (fn [e] (= (get e "type") "invoice.payment.received")) evs)
        match (filter
                (fn [p]
                  (let [paid-at (get (get p "payload") "paid_at")]
                    (= (date-format paid-at "yyyy-MM") year-month)))
                pays)]
    (sum (map (fn [p] (get (get p "payload") "paid_amount_krw")) match))))

; ── backward-compat wrapper: monthly-revenue(year-month) ───────
(defn monthly-revenue [year-month]
  (let [evs (read-events)]
    (monthly-revenue-from-events year-month evs)))

; ── 오늘 due 인 송장 필터 ──────────────────────────────────
(defn due-today-from-invoices [invs]
  (let [today-y-m-d (date-format (now-ms) "yyyy-MM-dd")]
    (filter
      (fn [inv]
        (and (not (= (get inv "status") "paid"))
             (= (date-format (get inv "due_at") "yyyy-MM-dd") today-y-m-d)))
      invs)))

; ── backward-compat wrapper: due-today() ───────────────────────
(defn due-today []
  (due-today-from-invoices (list-invoices)))

; ── 이번 주 due 필터 (지금부터 7일 이내, 만기 미경과·미완납만) ──
(defn due-this-week-from-invoices [invs]
  (let [now (now-ms)
        end (date-add now "days" 7)]
    (filter
      (fn [inv]
        (and (not (= (get inv "status") "paid"))
             (let [d (get inv "due_at")]
               (and (not (nil? d))
                    (>= d now)
                    (<= d end)))))
      invs)))

; ── backward-compat wrapper: due-this-week() ───────────────────
(defn due-this-week []
  (due-this-week-from-invoices (list-invoices)))

; ── ID 생성: <ts>-<6 hex> (sortable) ───────────────────────
(defn make-invoice-id []
  (let [u (uuid)]
    (str (now-ms) "-" (str-slice u 0 6))))
