; soloflow main.fl — 엔트리. 모듈 로드 + 라우트 등록 + 서버 시작.
; SPEC.airc hot=task-001. 포트 41955.

(load "src/render.fl")
(load "src/state.fl")
(load "src/invoice.fl")
(load "src/contract-template.fl")
(load "src/contract-state.fl")
(load "src/contract.fl")
(load "src/cron.fl")
(load "src/schedule-state.fl")
(load "src/schedule.fl")

; ── 라우트 등록 (22개: invoice 8 + contract 6 + schedule 8) ──
; invoice 8 (M1.1: send/cancel 추가)
(server-get  "/"                    "handle-index")
(server-get  "/invoices"            "handle-invoices")
(server-get  "/invoices/new"        "handle-new-form")
(server-post "/invoices"            "handle-create")
(server-get  "/invoices/:id"        "handle-detail")
(server-post "/invoices/:id/send"   "handle-send")
(server-post "/invoices/:id/cancel" "handle-cancel")
(server-post "/invoices/:id/pay"    "handle-pay")
; contract 6
(server-get  "/contracts"            "handle-contracts-list")
(server-get  "/contracts/new"        "handle-contract-new-form")
(server-post "/contracts"            "handle-contract-create")
(server-get  "/contracts/:id"        "handle-contract-detail")
(server-post "/contracts/:id/sign"   "handle-contract-sign")
(server-get  "/contracts/:id/print"  "handle-contract-print")
; schedule 8 (M3: project timeline + daily focus)
(server-get  "/schedule"                                 "handle-schedule-list")
(server-get  "/schedule/project/new"                     "handle-project-new-form")
(server-post "/schedule/project"                         "handle-project-create")
(server-get  "/schedule/project/:id"                     "handle-project-detail")
(server-post "/schedule/project/:id/milestone"           "handle-milestone-add")
(server-post "/schedule/project/:id/milestone/:mid/complete" "handle-milestone-complete")
(server-post "/schedule/project/:id/focus-start"         "handle-focus-start")
(server-post "/schedule/project/:id/focus-end"           "handle-focus-end")

(println "soloflow listening on http://localhost:41955")
(server-start 41955)
