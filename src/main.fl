; soloflow main.fl — 엔트리. 모듈 로드 + 라우트 등록 + 서버 시작.
; SPEC.airc hot=task-001. 포트 41955.

(load "src/render.fl")
(load "src/state.fl")
(load "src/invoice.fl")
(load "src/contract-template.fl")
(load "src/contract-state.fl")
(load "src/contract.fl")
(load "src/contract-invoice-link-state.fl")
(load "src/contract-invoice-link.fl")
(load "src/template-state.fl")
(load "src/template.fl")
(load "src/cron.fl")
(load "src/schedule-state.fl")
(load "src/schedule.fl")
(load "src/focus-state.fl")
(load "src/focus.fl")
(load "src/delivery-state.fl")
(load "src/delivery.fl")
(load "src/api.fl")

; ── 라우트 등록 (53개: invoice 8 + contract 7 + contract-invoice-link 2 + template 5 + schedule 8 + focus 11 + delivery 5 + api 7) ──
; invoice 8 (M1.1: send/cancel 추가)
(server-get  "/"                    "handle-index")
(server-get  "/invoices"            "handle-invoices")
(server-get  "/invoices/new"        "handle-new-form")
(server-post "/invoices"            "handle-create")
(server-get  "/invoices/:id"        "handle-detail")
(server-post "/invoices/:id/send"   "handle-send")
(server-post "/invoices/:id/cancel" "handle-cancel")
(server-post "/invoices/:id/pay"    "handle-pay")
; contract 7 (v1.2-P0: cancel 추가)
(server-get  "/contracts"            "handle-contracts-list")
(server-get  "/contracts/new"        "handle-contract-new-form")
(server-post "/contracts"            "handle-contract-create")
(server-get  "/contracts/:id"        "handle-contract-detail")
(server-post "/contracts/:id/sign"   "handle-contract-sign")
(server-post "/contracts/:id/cancel" "handle-contract-cancel")
(server-get  "/contracts/:id/print"  "handle-contract-print")
; contract-invoice-link 2 (v1.1-C: 계약↔송장 연결)
(server-post "/contracts/:cid/invoice/:iid/link"   "handle-contract-invoice-link")
(server-post "/contracts/:cid/invoice/:iid/unlink" "handle-contract-invoice-unlink")
; template 5 (v1.1-B: multi-template CRUD)
(server-get  "/template/list"        "handle-template-list")
(server-post "/template/create"      "handle-template-create")
(server-post "/template/:id/update"  "handle-template-update")
(server-post "/template/:id/archive" "handle-template-archive")
(server-post "/template/:id/select"  "handle-template-select")
; schedule 8 (M3: project timeline + daily focus)
(server-get  "/schedule"                                 "handle-schedule-list")
(server-get  "/schedule/project/new"                     "handle-project-new-form")
(server-post "/schedule/project"                         "handle-project-create")
(server-get  "/schedule/project/:id"                     "handle-project-detail")
(server-post "/schedule/project/:id/milestone"           "handle-milestone-add")
(server-post "/schedule/project/:id/milestone/:mid/complete" "handle-milestone-complete")
(server-post "/schedule/project/:id/focus-start"         "handle-focus-start")
(server-post "/schedule/project/:id/focus-end"           "handle-focus-end")
; focus 11 (M4: Pomodoro 6 + Habit 5)
(server-get  "/focus"                      "handle-focus-today")
(server-post "/focus/start"                "handle-focus-start")
(server-post "/focus/pause"                "handle-focus-pause")
(server-post "/focus/resume"               "handle-focus-resume")
(server-post "/focus/complete"             "handle-focus-complete")
(server-post "/focus/cancel"               "handle-focus-cancel")
(server-get  "/habit/list"                 "handle-habit-list")
(server-post "/habit"                      "handle-habit-create")
(server-post "/focus/habit/:id/check"      "handle-habit-check")
(server-post "/focus/habit/:id/uncheck"    "handle-habit-uncheck")
(server-post "/habit/:id/archive"          "handle-habit-archive")
; delivery 5 (v1.1-A: channel audit trail)
(server-get  "/delivery"                   "handle-delivery-list")
(server-post "/delivery/request"           "handle-delivery-request")
(server-post "/delivery/:id/sent"          "handle-delivery-sent")
(server-post "/delivery/:id/failed"        "handle-delivery-failed")
(server-post "/delivery/:id/retry"         "handle-delivery-retry")

; api 7 (v1.3-P1: REST JSON API + API Key 인증)
(server-get  "/api/invoices"               "api-invoices-list")
(server-get  "/api/invoices/:id"           "api-invoices-detail")
(server-get  "/api/contracts"              "api-contracts-list")
(server-get  "/api/contracts/:id"          "api-contracts-detail")
(server-get  "/api/schedule/projects"      "api-schedule-projects-list")
(server-get  "/api/schedule/projects/:id"  "api-schedule-projects-detail")
(server-get  "/api/focus/today"            "api-focus-today")

(println "soloflow listening on http://localhost:41955")
(server-start 41955)
